# Copy to .env.local and fill in. Never commit real keys.
# Everything here is optional: without OpenAI the alebrije can't talk or paint,
# and without Supabase the altar is kept in this browser.
OPENAI_API_KEY=

# Optional overrides
OPENAI_CHAT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Supabase (Project Settings → API Keys). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
